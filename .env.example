# Local mode (default): free, no API key. Ollama runs as a Docker Compose service.
# Copy to .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Never commit .env.

# Starts the Ollama services in docker-compose.yml. Leave empty in cloud mode.
COMPOSE_PROFILES=local

# Any OpenAI-compatible endpoint. Inside Compose, Ollama is reachable as "ollama".
# Running the app on the host instead (uv run ...)? Use http://localhost:11434/v1
BASE_URL=http://ollama:11434/v1
API_KEY=
CHAT_MODEL=qwen3:4b-instruct
EMBEDDING_MODEL=bge-m3
REASONING_EFFORT=

# Cosine-similarity cut-off for "no relevant context". It belongs to EMBEDDING_MODEL:
# recalibrate with `python -m policydesk search "<question>"` when you change the model (docs/adr/004).
MIN_RELEVANCE_SCORE=0.55
TOP_K=4

# Failure policy (docs/adr/005). CPU generation is slow, so the deadline is generous and there are no retries.
REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=0
# Matches OLLAMA_NUM_PARALLEL=1 in docker-compose.yml.
MAX_CONCURRENT_MODEL_CALLS=1
QUEUE_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO
