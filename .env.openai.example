# Cloud mode: OpenAI API. Needs an API key (a question costs well under USD 0.001).
# Copy to .env:  cp .env.openai.example .env   (PowerShell: Copy-Item .env.openai.example .env)
# then put your key in API_KEY. Never commit .env.

# Empty: the Ollama services in docker-compose.yml are not started.
COMPOSE_PROFILES=

BASE_URL=https://api.openai.com/v1
API_KEY=
CHAT_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
# gpt-6-luna reasons at "medium" by default; answering from given excerpts needs no reasoning, and "none" is faster.
REASONING_EFFORT=none

# Cosine-similarity cut-off for "no relevant context". It belongs to EMBEDDING_MODEL:
# recalibrate with `python -m policydesk search "<question>"` when you change the model (docs/adr/004).
MIN_RELEVANCE_SCORE=0.3
TOP_K=4

# Failure policy (docs/adr/005).
REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
MAX_CONCURRENT_MODEL_CALLS=8
QUEUE_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO
